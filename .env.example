# RevenueCat MCP server (API v2 secret key — used by opencode, never expose to the app)
REVENUECAT_API_KEY=

# RevenueCat SDK keys (get from https://app.revenuecat.com → API Keys)
# Test Store key (development) — works for both iOS and Android
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=
# Production keys — generated after connecting your stores (goog_ = Android, appl_ = iOS)
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
